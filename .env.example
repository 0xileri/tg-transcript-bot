# From @BotFather -> /newbot. Treat like a password: anyone holding it controls the bot.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional allowlist. Bot tokens are effectively public once the bot has a username,
# so without this ANY Telegram user can make your machine run yt-dlp jobs.
# Comma-separated numeric chat ids. Empty or unset = answer everyone.
# Send /whoami to the bot to learn your own id.
ALLOWED_CHAT_IDS=

# How to invoke yt-dlp. The pip install puts yt-dlp.exe in a Scripts dir that is
# usually not on PATH, so going through the module is the reliable route.
YTDLP_CMD=python -m yt_dlp

# Hard ceiling per job, in seconds. Kills a hung extraction rather than wedging the queue.
JOB_TIMEOUT_SECONDS=180
